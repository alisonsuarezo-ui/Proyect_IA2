# =====================================================================
#  TaskFlow — variables de entorno
#  Copia este archivo como .env y ajusta los valores:  cp .env.example .env
#  NUNCA subas el archivo .env a un repositorio.
# =====================================================================

# ---------- Puertos expuestos en el host ----------
APP_PORT=8080
N8N_PORT=5678
POSTGRES_PORT=5432
QDRANT_PORT=6333

# ---------- PostgreSQL ----------
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=cambia-esta-contraseña

# ---------- Seguridad (JWT) ----------
# Cadena aleatoria de al menos 32 caracteres. Ej.: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=1440

# Zona horaria del negocio (fechas límite, recordatorios y cron de n8n)
APP_TIMEZONE=America/Bogota

# ---------- Inteligencia artificial (Spring AI) ----------
# Proveedor: openai | ollama
AI_PROVIDER=openai
# API key de OpenAI (https://platform.openai.com/api-keys). Si se deja vacía, TaskFlow
# funciona pero la búsqueda semántica y el RAG muestran "IA no configurada".
OPENAI_API_KEY=
# Cualquier API compatible con OpenAI (Azure OpenAI vía proxy, OpenRouter, etc.)
OPENAI_BASE_URL=https://api.openai.com
# Modelos (para ollama, p. ej. AI_CHAT_MODEL=llama3.1 y AI_EMBEDDING_MODEL=nomic-embed-text)
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# URL de Ollama si AI_PROVIDER=ollama (Ollama ejecutándose en el host)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Nº de tareas recuperadas por similitud y umbral mínimo de similitud coseno
RAG_TOP_K=8
RAG_MIN_SCORE=0.2

# ---------- Qdrant ----------
QDRANT_COLLECTION=taskflow_tasks
# Obligatoria: protege la API de Qdrant (cadena aleatoria). Ej.: openssl rand -base64 32
# No puede quedar vacía: Qdrant trata una clave vacía como autenticación activada.
QDRANT_API_KEY=cambia-esta-clave-de-qdrant

# ---------- n8n ----------
# Clave compartida entre n8n y TaskFlow (cabecera X-API-Key)
N8N_API_KEY=cambia-esta-clave-compartida-n8n
# Clave de cifrado de credenciales de n8n (cadena aleatoria)
N8N_ENCRYPTION_KEY=cambia-esta-clave-de-cifrado-n8n
